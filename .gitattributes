# 原生分发清单按源码字节校验，固定换行以保持检出的指纹一致。
/stdlib/time/native/**/*.c text eol=lf
/stdlib/time/native/**/*.h text eol=lf

# 强制将 .ms 文件归类并标记为 Mas lang 语言
*.ms linguist-language=Mas-lang linguist-detectable=true

# 确保 Cargo 项目中的 .rs 文件被正常计入（避免被误当成 Vendored/Documentation 排除）
*.rs linguist-detectable=true
